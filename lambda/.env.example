# Copy to .env and fill in what applies; .env is never committed.
# Local runs read it automatically; `osls deploy` reads the same variables.

# AWS (Serverless Framework / osls)
AWS_PROFILE=your-profile
AWS_REGION=ap-east-1
STAGE=dev

# Secrets Manager secret that holds all eight credential keys as one JSON
# document (see README.md "Secrets"). Lambda reads it at start-up.
CREDENTIALS_SECRET_NAME=cims/cims-gcis-act/smoke-credentials

# Credentials for local runs only (never hardcoded, never logged).
#   portal / upload : School Portal
#   booking         : Online Booking, Child Health Service
#   stdhs           : Online Booking, Student Health Service
#   pdqa            : Online Booking, Families Clinics
TEST_USERNAME=
TEST_PASSWORD=
OB_LOGIN=
OB_PASSWORD=
STDHS_LOGIN=
STDHS_PASSWORD=
PDQA_LOGIN=
PDQA_PASSWORD=

# Optional
# SMOKE_SCHEDULE=cron(0 18 * * ? *)   # UTC; default 18:00 UTC = 02:00 HKT
# DEFAULT_TARGET=portal                # target used when the event names none
# ALARM_EMAIL=your-team@example.com    # e-mail for the failure alarm
# SERVICE_NAME=cims-gcis-act-smoke
# OB_ATTEMPTS=5                        # captcha attempts per Online Booking login
