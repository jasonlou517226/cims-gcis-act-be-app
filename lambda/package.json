{
  "name": "cims-gcis-act-smoke-lambda",
  "version": "1.0.0",
  "private": true,
  "description": "Scheduled Playwright smoke tests (DH School Portal + Online Booking SPA) on AWS Lambda",
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "prepare": "npm run build --silent",
    "build": "node scripts/build-package-assets.mjs && node scripts/build-function.mjs",
    "build:assets": "node scripts/build-package-assets.mjs",
    "build:function": "node scripts/build-function.mjs",
    "install-browser": "node scripts/install-browser.mjs chromium",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "local": "node --experimental-strip-types src/local.ts",
    "package": "osls package",
    "deploy": "osls deploy"
  },
  "dependencies": {
    "playwright-core": "1.65.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "158.0.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.7",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "osls": "^3.62.1",
    "typescript": "5.9.3"
  }
}
